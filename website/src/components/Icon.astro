    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
>
    {name === 'windows' ? (
        <path
            fill="currentColor"
            stroke="none"
            d="M2 4.4 11 3v8H2Zm10-1.6L22 1v10H12ZM2 12h9v8l-9-1.4Zm10 0h10v11l-10-1.8Z"
