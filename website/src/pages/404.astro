---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/site';
---

<Base
    title="A little off the trail — Kitsu"
    description="This Kitsu page could not be found. Head home or find your way through the documentation."
    noindex
>
    <section class="not-found wrap">
        <p class="eyebrow" style="justify-content:center">
            404 / A LITTLE OFF THE TRAIL
        </p>
        <h1>Even foxes take a wrong turn.</h1>
        <p>This page has wandered off. Let’s get you somewhere familiar.</p>
        <a class="button" href={url()}>
            Back to Kitsu <Icon name="arrow" size={17} />
        </a>
        <p>
            <a class="text-link" href={url('docs/')}>
                Or explore the docs <Icon name="book" size={16} />
            </a>
        </p>
    </section>
</Base>
