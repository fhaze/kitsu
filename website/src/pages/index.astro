---
import Base from '../layouts/Base.astro';
import TerminalDemo from '../components/TerminalDemo.astro';
import Icon from '../components/Icon.astro';
import {
    url,
    release,
    installerUrl,
    portableUrl,
    repository,
} from '../lib/site';
---

<Base>
    <section class="hero wrap" aria-labelledby="hero-title">
        <a class="release-pill" href={release.url}>
            <span class="status-dot"></span>
            {release.tag ? `${release.tag} is here` : 'Meet your new terminal'}
            <span class="pill-divider"></span>Free & open source
            <Icon name="arrow" size={13} />
        </a>
        <h1 id="hero-title">
            Your terminal.
            <br />
            <span>Now on Windows.</span>
            <span class="hero-spark" aria-hidden="true">
                ✳
            </span>
        </h1>
        <p class="hero-description">
            Kitty’s GPU-powered terminal, at home on Windows.
            <br class="desktop-break" /> All your shells, a little more
            possibility.
        </p>
        <div class="hero-actions">
            <a class="button" href={installerUrl}>
                <Icon name="windows" size={17} />
                {release.installer
                    ? 'Download for Windows'
                    : 'Get Kitsu for Windows'}
                <Icon name="download" size={17} />
            </a>
            <a class="button button-outline" href={url('docs/')}>
                Meet the docs <Icon name="external" size={17} />
            </a>
        </div>
        <p class="download-meta">
            Windows 10 1809+ · x86_64 <span>·</span>{' '}
            <a href={portableUrl}>
                {release.portable ? 'Portable ZIP' : 'Browse downloads'}{' '}
                <Icon name="external" size={11} />
            </a>
        </p>
        <TerminalDemo />
    </section>

    <div class="foundation wrap">
        <div>
            <Icon name="cpu" size={19} />
            <span>GPU-powered rendering</span>
        </div>
        <div>
            <Icon name="windows" size={17} />
            <span>Native Win32 & ConPTY</span>
        </div>
        <div>
            <Icon name="branch" size={19} />
            <span>Open source. Always curious.</span>
        </div>
    </div>

    <section
        id="features"
        class="features-section wrap section-space"
        aria-labelledby="features-title"
    >
        <div class="section-heading">
            <div>
                <p class="eyebrow">
                    <span></span> A BETTER PLACE TO WORK
                </p>
                <h2 id="features-title">
                    A familiar shell.
                    <br />A whole new habitat.
                </h2>
            </div>
            <p>
                Keep the tools you love. Give them a terminal
                <br class="desktop-break" /> that makes room for more.
            </p>
        </div>
        <div class="feature-rows">
            <article class="feature-row">
                <span class="feature-number">01 /</span>
                <div class="feature-copy">
                    <h3>Put your GPU to work.</h3>
                    <p>
                        Kitty’s GPU rendering engine brings rich text,
                        ligatures, Unicode, and inline graphics to your Windows
                        workflow.
                    </p>
                </div>
                <div class="feature-art typography-art" aria-hidden="true">
                    <span>
                        Aa<span>→</span>
                    </span>
                    <small>
                        ligatures &nbsp; · &nbsp; true color &nbsp; · &nbsp;
                        unicode
                    </small>
                </div>
                <Icon name="cpu" size={25} />
            </article>
            <article class="feature-row">
                <span class="feature-number">02 /</span>
                <div class="feature-copy">
                    <h3>Find your kind of organized.</h3>
                    <p>
                        Tabs, panes, and flexible layouts. Keep your editor,
                        shell, and that one long-running command comfortably
                        side by side.
                    </p>
                </div>
                <div class="feature-art panes-art" aria-hidden="true">
                    <div>
                        <span>~/code</span>
                    </div>
                    <div>
                        <span>~/serve</span>
                    </div>
                    <div>
                        <span>~/just-one-more-thing</span>
                    </div>
                </div>
                <Icon name="layers" size={25} />
            </article>
            <article class="feature-row">
                <span class="feature-number">03 /</span>
                <div class="feature-copy">
                    <h3>Different shells. Same home.</h3>
                    <p>
                        PowerShell, classic cmd, or a Linux session through WSL.
                        Native Windows windows, with ConPTY doing the
                        connecting.
                    </p>
                </div>
                <div
                    class="feature-art shells-art"
                    aria-label="Supported shell examples"
                >
                    <span>
                        <b>›_</b> PowerShell
                    </span>
                    <span>
                        <b>~</b> WSL
                    </span>
                    <span>
                        <b>_</b> cmd
                    </span>
                </div>
                <Icon name="terminal" size={25} />
            </article>
        </div>
    </section>

    <section class="kitty-section wrap" aria-labelledby="kitty-title">
        <div class="kitty-card">
            <div class="kitty-card-copy">
                <p class="eyebrow">GOOD ROOTS. NEW POSSIBILITIES.</p>
                <h2 id="kitty-title">
                    A little Kitty.
                    <br />A little Windows.
                    <br />
                    <span>A lot to make your own.</span>
                </h2>
                <p>
                    Kitsu brings Kitty’s tabs, layouts, kittens, and terminal
                    protocols to Windows, with native integration and a familiar
                    configuration.
                </p>
                <a class="text-link" href={repository}>
                    Explore the project <Icon name="external" size={16} />
                </a>
            </div>
            <div class="kitty-code">
                <div class="code-header">
                    <span>
                        <Icon name="terminal" size={16} /> start-something.ps1
                    </span>
                    <span>PowerShell</span>
                </div>
                <div class="code-lines">
                    <p>
                        <span>01</span>
                        <i># Make yourself at home</i>
                    </p>
                    <p>
                        <span>02</span>kitsu pwsh.exe
                    </p>
                    <p>
                        <span>03</span>
                    </p>
                    <p>
                        <span>04</span>
                        <i># Bring WSL along</i>
                    </p>
                    <p>
                        <span>05</span>kitsu +wsl-setup
                    </p>
                    <p>
                        <span>06</span>
                    </p>
                    <p>
                        <span>07</span>
                        <i># Find a fresh coat of paint</i>
                    </p>
                    <p>
                        <span>08</span>kitsu +kitten themes
                    </p>
                    <p>
                        <span>09</span>
                    </p>
                    <p>
                        <span>10</span>
                        <i># See how things are doing</i>
                    </p>
                    <p>
                        <span>11</span>kitsu +health-check --mode=quick
                    </p>
                </div>
                <a href={url('windows/')}>
                    Your first session starts here{' '}
                    <Icon name="arrow" size={15} />
                </a>
            </div>
        </div>
    </section>

    <section
        class="getting-started wrap section-space"
        aria-labelledby="start-title"
    >
        <div class="section-heading">
            <div>
                <p class="eyebrow">
                    <span></span> LESS SETUP. MORE DOING.
                </p>
                <h2 id="start-title">Settle in. Start something.</h2>
            </div>
            <a class="text-link" href={url('install/')}>
                The installation guide <Icon name="arrow" size={17} />
            </a>
        </div>
        <div class="steps">
            <article>
                <span class="step-number">1</span>
                <h3>Meet your new terminal.</h3>
                <p>
                    Grab the Windows installer. Prefer to travel light? There’s
                    a portable ZIP, too.
                </p>
                <a href={url('install/')}>
                    Choose your download <Icon name="arrow" size={15} />
                </a>
            </article>
            <article>
                <span class="step-number">2</span>
                <h3>Bring your favorite shell.</h3>
                <p>
                    Open PowerShell or cmd. Set up the bundled Linux kitten
                    helper for your WSL distributions.
                </p>
                <a href={url('windows/')}>
                    Make yourself at home <Icon name="arrow" size={15} />
                </a>
            </article>
            <article>
                <span class="step-number">3</span>
                <h3>Make it feel like you.</h3>
                <p>
                    Your themes, fonts, shortcuts, and layouts. Your Kitty
                    configuration keeps its familiar home.
                </p>
                <a href={url('windows/#configuration')}>
                    Find your configuration <Icon name="arrow" size={15} />
                </a>
            </article>
        </div>
    </section>

    <section class="download-section wrap" aria-labelledby="download-title">
        <div class="download-card">
            <div>
                <span class="eyebrow">READY WHEN YOU ARE</span>
                <h2 id="download-title">A new home for your next idea.</h2>
                <p>Free, open source, and made for your Windows workflow.</p>
            </div>
            <div>
                <a class="button" href={installerUrl}>
                    <Icon name="windows" size={17} /> Get Kitsu{' '}
                    <Icon name="download" size={17} />
                </a>
                <a class="download-secondary" href={release.url}>
                    {release.tag ?? 'View the latest release'}{' '}
                    <Icon name="external" size={12} />
                </a>
            </div>
            <span class="download-decoration" aria-hidden="true">
                ✳
            </span>
        </div>
    </section>
</Base>
