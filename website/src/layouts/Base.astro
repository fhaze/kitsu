---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { url, repository, installerUrl, release } from '../lib/site';
import themeScript from '../scripts/theme.js?raw';

interface Props {
    title?: string;
    description?: string;
    noindex?: boolean;
}
const {
    title = 'Kitsu — A GPU-powered terminal for Windows',
    description = 'Kitty’s GPU-powered terminal, at home on Windows. Native windows, PowerShell, cmd, WSL, tabs, layouts, and kittens. Free and open source.',
    noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isDocumentation = [
    'docs/',
    'install/',
    'windows/',
    'troubleshooting/',
].some((path) => Astro.url.pathname === url(path));
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f8f7f3" />
        <script is:inline set:html={themeScript} />
        {noindex && <meta name="robots" content="noindex" />}
        <link rel="icon" type="image/png" href={url('kitsu-128.png')} />
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta
            property="og:image"
            content={new URL(url('kitsu.png'), Astro.site).href}
        />
        <meta name="twitter:card" content="summary" />
        <title>{title}</title>
    </head>
    <body>
        <a class="skip-link" href="#main">
            Skip to content
        </a>
        <header class="site-header wrap">
            <a class="brand" href={url()} aria-label="Kitsu home">
                <img src={url('kitsu-128.png')} width="35" height="35" alt="" />
                <span>
                    kitsu<span class="brand-dot">.</span>
                </span>
            </a>
            <nav class="desktop-nav" aria-label="Main navigation">
                <a href={url('#features')}>Features</a>
                <a
                    href={url('docs/')}
                    aria-current={isDocumentation ? 'location' : undefined}
                >
                    Documentation
                </a>
                <a href={release.url}>
                    Releases <Icon name="external" size={13} />
                </a>
            </nav>
            <div class="header-actions">
                <button
                    class="theme-toggle"
                    type="button"
                    data-theme-toggle
                    aria-label="Switch to dark theme"
                    aria-pressed="false"
                    title="Switch to dark theme"
                    hidden
                >
                    <Icon name="moon" size={18} class="theme-icon-moon" />
                    <Icon name="sun" size={18} class="theme-icon-sun" />
                </button>
                <a
                    class="github-link"
                    href={repository}
                    aria-label="Kitsu on GitHub"
                >
                    <Icon name="github" size={21} />
                </a>
                <a class="button button-small" href={url('install/')}>
                    Get Kitsu <Icon name="arrow" size={15} />
                </a>
                <button
                    class="menu-toggle"
                    aria-expanded="false"
                    aria-controls="mobile-nav"
                    aria-label="Open navigation"
                >
                    <Icon name="menu" />
                </button>
            </div>
            <nav
                id="mobile-nav"
                class="mobile-nav"
                aria-label="Mobile navigation"
                hidden
            >
                <a href={url('#features')}>Features</a>
                <a href={url('docs/')}>Documentation</a>
                <a href={release.url}>Releases</a>
                <a href={repository}>GitHub</a>
            </nav>
        </header>
        <main id="main">
            <slot />
        </main>
        <footer class="site-footer wrap">
            <div class="footer-top">
                <a class="brand" href={url()}>
                    <img
                        src={url('kitsu-128.png')}
                        width="30"
                        height="30"
                        alt=""
                    />
                    <span>
                        kitsu<span class="brand-dot">.</span>
                    </span>
                </a>
                <p>A little fox. A lot of terminal.</p>
                <a class="text-link" href={repository}>
                    Built in the open <Icon name="github" size={17} />
                </a>
            </div>
            <div class="footer-bottom">
                <p>
                    An independent Windows fork of{' '}
                    <a href="https://github.com/kovidgoyal/kitty">Kitty</a>,
                    created by Kovid Goyal.
                    <br />
                    Kitsu is maintained by{' '}
                    <a href="https://github.com/fhaze">FHaze</a>. Licensed under{' '}
                    <a href={`${repository}/blob/master/LICENSE`}>GPLv3</a>.
                </p>
                <div>
                    <a href={url('docs/')}>Docs</a>
                    <a href={`${repository}/issues`}>
                        Report an issue <Icon name="external" size={12} />
                    </a>
                    <a href={installerUrl}>
                        Download <Icon name="download" size={13} />
                    </a>
                </div>
            </div>
        </footer>
        <div
            class="sr-only"
            role="status"
            id="copy-status"
            aria-live="polite"
        ></div>
        <script>
            const toggle =
                document.querySelector<HTMLButtonElement>('.menu-toggle');
            const menu = document.querySelector<HTMLElement>('#mobile-nav');
            const closeMenu = () => {
                toggle?.setAttribute('aria-expanded', 'false');
                toggle?.setAttribute('aria-label', 'Open navigation');
                if (menu) menu.hidden = true;
            };
            toggle?.addEventListener('click', () => {
                const expanded =
                    toggle.getAttribute('aria-expanded') !== 'true';
                toggle.setAttribute('aria-expanded', String(expanded));
                toggle.setAttribute(
                    'aria-label',
                    expanded ? 'Close navigation' : 'Open navigation',
                );
                if (menu) menu.hidden = !expanded;
            });
            menu?.querySelectorAll('a').forEach((link) =>
                link.addEventListener('click', closeMenu),
            );
            document.addEventListener('keydown', (event) => {
                if (
                    event.key === 'Escape' &&
                    toggle?.getAttribute('aria-expanded') === 'true'
                ) {
                    closeMenu();
                    toggle.focus();
                }
            });
            document
                .querySelectorAll<HTMLPreElement>('.guide-content pre')
                .forEach((block) => {
                    const button = document.createElement('button');
                    button.className = 'copy-code';
                    button.type = 'button';
                    button.textContent = 'Copy';
                    button.setAttribute('aria-label', 'Copy code example');
                    button.dataset.copy =
                        block.querySelector('code')?.textContent ?? '';
                    block.append(button);
                });
            document
                .querySelectorAll<HTMLButtonElement>('[data-copy]')
                .forEach((button) => {
                    button.addEventListener('click', async () => {
                        const original = button.innerHTML;
                        const status = document.querySelector('#copy-status');
                        try {
                            await navigator.clipboard.writeText(
                                button.dataset.copy ?? '',
                            );
                            button.textContent = 'Copied!';
                            if (status)
                                status.textContent =
                                    'Command copied to clipboard.';
                        } catch {
                            button.textContent = 'Select to copy';
                            if (status)
                                status.textContent =
                                    'Copy unavailable. Select and copy the command manually.';
                        }
                        window.setTimeout(() => {
                            button.innerHTML = original;
                        }, 2000);
                    });
                });
        </script>
    </body>
</html>
