{
    "name": "kitsu-website",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare-site": "node scripts/prepare.mjs",
        "dev": "npm run prepare-site && astro dev --host 127.0.0.1",
        "build": "npm run prepare-site && astro check && astro build",
        "preview": "astro preview --host 127.0.0.1",
        "test": "node --test scripts/*.test.mjs",
        "check": "node scripts/check-site.mjs",
        "format": "prettier --ignore-path .gitignore --write ."
    },
    "dependencies": {
        "@fontsource-variable/manrope": "5.3.0",
        "@fontsource/ibm-plex-mono": "5.3.0",
        "astro": "7.4.1"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "prettier": "3.9.10",
        "prettier-plugin-astro": "1.1.1",
        "typescript": "6.0.3"
    }
}
